# ==============================================================================
# ChaosLab Lightweight Kubernetes Cluster Agent Container Image
# ==============================================================================
FROM python:3.12-slim

WORKDIR /app

# Install kubectl for cluster probing and Chaos Mesh interaction
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl" \
    && install -o root -g root -m 0755 kubectl /usr/local/bin/kubectl \
    && rm kubectl \
    && rm -rf /var/lib/apt/lists/*

# Install Python requirements
RUN pip install --no-cache-dir pyyaml requests

# Copy ChaosLab agent and execution engine
COPY chaoslab/ ./chaoslab/

ENV PYTHONUNBUFFERED=1 \
    CHAOSLAB_SERVER_URL=http://localhost:8000

ENTRYPOINT ["python", "chaoslab/platform/agent/agent.py"]
