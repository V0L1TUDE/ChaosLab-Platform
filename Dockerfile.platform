# ==============================================================================
# ChaosLab Hosted SaaS Platform & Control Plane Container Image
# ==============================================================================
FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt* ./
RUN pip install --no-cache-dir pyyaml requests

# Copy ChaosLab platform and core engine
COPY chaoslab/ ./chaoslab/
COPY tests/ ./tests/

# Set environment defaults
ENV PYTHONUNBUFFERED=1 \
    CHAOSLAB_PORT=8000 \
    CHAOSLAB_DB_PATH=/app/data/chaoslab_platform.db \
    CHAOSLAB_JWT_SECRET=chaoslab-production-secure-key-32bytes-min

# Create persistent storage volume mount point
RUN mkdir -p /app/data /app/chaoslab/reports

EXPOSE 8000

# Health check
HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8000/api/v1/health || exit 1

ENTRYPOINT ["python", "chaoslab/platform/backend/server.py", "8000"]
